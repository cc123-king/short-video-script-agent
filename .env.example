# 使用控制台“API Key”页面显示的 OpenAI 兼容 Base URL。
# 新工作空间 Key：将下方地址改为 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 下方 DashScope 地址用于兼容旧域名；Key、工作空间及地域必须与地址匹配。
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT_SECONDS=60
